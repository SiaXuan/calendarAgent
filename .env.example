# ── REQUIRED ─────────────────────────────────────────────────────────────────
# Your own Claude API key. This is the ONLY value you must set: task
# decomposition, chat adjustments, and plan import all call Claude.
# Get one at https://console.anthropic.com. Your key must be able to access the
# default models below (or override them).
ANTHROPIC_API_KEY=sk-ant-...

# ── OPTIONAL · LLM model selection (defaults baked into agents/llm.py) ────────
# Override if your key can't reach the defaults, or to try another version /
# an OpenAI-compatible endpoint.
# LLM_REASON_MODEL=claude-sonnet-4-6          # decomposition / chat agent / import
# LLM_REASON_TEMPERATURE=0.3
# LLM_FAST_MODEL=claude-haiku-4-5-20251001    # only non-English health summaries
# LLM_FAST_TEMPERATURE=0.0

# ── OPTIONAL · LangSmith tracing ─────────────────────────────────────────────
# Set LANGSMITH_TRACING=true to send graph/LLM traces to LangSmith. Key at
# https://smith.langchain.com → Settings → API Keys.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=dayflow

# ── iCloud CalDAV: not used ──────────────────────────────────────────────────
# All Calendar/Reminders access goes through EventKit in the Swift client. No
# live code reads CALDAV_*; the old client is kept under legacy/caldav/ for
# reference only. If an older .env of yours has these, they can be deleted.

# ── MCP servers (optional) ───────────────────────────────────────────────────
# Set these, restart the backend (it reads .env only at startup), then
# POST /mcp/presets/<key>/attach. GET /mcp/presets lists what each one is still
# missing. Nothing prompts for them; the agent just runs without.
# Servers launch via `uvx`, installed with requirements.txt.
# Weather and commute times are preferences, not env vars — see the README's
# "Optional integrations" section.

# Canvas LMS — assignments and due dates become schedulable tasks. Read-only:
# the server runs in its student role with every write tool removed.
# Token: Canvas → Account → Settings → Approved Integrations → New Access Token
# (shown once). Some schools disable self-service tokens and issue them through
# IT; some expire them after 30 days.
# URL is your school's Canvas address plus /api/v1, https only, e.g.
# https://yourschool.instructure.com/api/v1
CANVAS_API_TOKEN=
CANVAS_API_URL=

# Gmail + Google Calendar (read-only). In Google Cloud Console: enable the
# Gmail API and Google Calendar API, set the OAuth consent screen to External
# (a personal gmail.com has no organisation) and add yourself as a test user,
# then create an OAuth client of type "Desktop app" — no redirect URI to set.
# The first time the agent reads mail, a Google consent page opens in your
# browser (callback on localhost:8765); approve it and ask again. While the
# consent screen is in "Testing" status, Google expires that grant after 7 days
# and the same page appears again.
# USER_GOOGLE_EMAIL is the account to read; the backend passes it to every tool
# call itself.
# (Google's 2026-11-11 "AI-powered agent" client requirement applies only to
# Google-hosted MCP servers, not to this one, which calls the REST APIs.)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
USER_GOOGLE_EMAIL=
