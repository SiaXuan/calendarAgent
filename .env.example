# ── REQUIRED ─────────────────────────────────────────────────────────────────
# Your own Claude API key. This is the ONLY value you must set: task
# decomposition, chat adjustments, and plan import all call Claude.
# Get one at https://console.anthropic.com. Your key must be able to access the
# default models below (or override them).
ANTHROPIC_API_KEY=sk-ant-...

# ── OPTIONAL · LLM model selection (defaults baked into agents/llm.py) ────────
# Override if your key can't reach the defaults, or to try another version /
# an OpenAI-compatible endpoint.
# LLM_REASON_MODEL=claude-sonnet-4-6          # decomposition / chat agent / import
# LLM_REASON_TEMPERATURE=0.3
# LLM_FAST_MODEL=claude-haiku-4-5-20251001    # only non-English health summaries
# LLM_FAST_TEMPERATURE=0.0

# ── OPTIONAL · LangSmith tracing ─────────────────────────────────────────────
# Set LANGSMITH_TRACING=true to send graph/LLM traces to LangSmith. Key at
# https://smith.langchain.com → Settings → API Keys.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=dayflow

# ── LEGACY · iCloud CalDAV (NOT needed for the Swift client) ──────────────────
# Phase 4 moved ALL Calendar/Reminders I/O to local EventKit in the Swift client
# (see docs/ARCHITECTURE.md §0). On the Swift path the backend never talks to
# iCloud, so leave these UNSET. Only fill them in if you deliberately run the old
# CalDAV fallback (e.g. the web UI with no Swift client uploading local events).
# CALDAV_URL=https://caldav.icloud.com
# CALDAV_USERNAME=you@icloud.com
# CALDAV_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── MCP servers (optional) ───────────────────────────────────────────────────
# Set these, then POST /mcp/presets/<key>/attach. GET /mcp/presets shows what's
# still missing. Nothing prompts for them; the agent just runs without.

# Canvas LMS — assignments and due dates become schedulable tasks.
# Token: Canvas → Account → Settings → New Access Token.
# URL must include /api/v1, e.g. https://canvas.instructure.com/api/v1
CANVAS_API_TOKEN=
CANVAS_API_URL=

# Gmail + Google Calendar. Build an OAuth client in Google Cloud Console:
# a personal gmail.com has no organisation, so choose External and add yourself
# as a test user. Tick "Use this client for an AI-powered agent" — from
# 2026-11-11 Google Workspace MCP servers reject clients without it.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
