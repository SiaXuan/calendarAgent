ANTHROPIC_API_KEY=sk-ant-...

# ── LLM model selection (optional — defaults baked into agents/llm.py) ──────
# Override these to test a different Claude version, or swap providers entirely
# (e.g. an OpenAI-compatible endpoint via langchain-anthropic-compatible setup).
# LLM_FAST_MODEL=claude-haiku-4-5-20251001
# LLM_FAST_TEMPERATURE=0.0
# LLM_REASON_MODEL=claude-sonnet-4-6
# LLM_REASON_TEMPERATURE=0.3

# ── Apple Calendar (iCloud CalDAV) ──────────────────────────────────────────
# URL: always https://caldav.icloud.com
# USERNAME: your Apple ID email
# PASSWORD: App-Specific Password — generate at appleid.apple.com
#   → Sign-In and Security → App-Specific Passwords
CALDAV_URL=https://caldav.icloud.com
CALDAV_USERNAME=you@icloud.com
CALDAV_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── LangSmith tracing (optional) ────────────────────────────────────────────
# Set LANGSMITH_TRACING=true to send graph traces to LangSmith. Get the key at
# https://smith.langchain.com → Settings → API Keys.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=dayflow
